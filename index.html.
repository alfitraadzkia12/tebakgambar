<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Game Tebak Gambar</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="game-container">
    <h1>Tebak Gambar</h1>
    <div class="score-board">
      Skor: <span id="score">0</span>
    </div>

    <div class="image-box">
      <img id="game-image" src="" alt="Gambar Soal">
    </div>

    <p id="hint-text" class="hint"></p>

    <div class="input-group">
      <input type="text" id="user-input" placeholder="Ketik jawabanmu di sini..." autocomplete="off">
      <button id="submit-btn" onclick="checkAnswer()">Jawab</button>
    </div>

    <p id="feedback" class="feedback"></p>

    <button id="next-btn" class="btn-next" onclick="nextQuestion()" style="display: none;">Soal Berikutnya →</button>
  </div>

  <script src="script.js"></script>
</body>
</html>
